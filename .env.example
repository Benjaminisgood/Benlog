# 复制本文件为 .env 后再填写。不要把 .env 提交到仓库。
# cp .env.example .env

# 会话签名。留空时，首次启动会在 instance/.secret_key 生成随机值。
# 生产环境请自行设置一长串随机字符。
SECRET_KEY=

# 1 才会打开调试器。默认关闭。
FLASK_DEBUG=0

HOST=127.0.0.1
PORT=5000

# 留空则使用 instance/site.db（SQLite）
DATABASE_URL=

# 三者都填写，且数据库里还没有用户时，启动时会创建管理员。
# 也可以留空，改用网页 /setting/setup 或命令：flask --app Benlog.app create-admin
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 默认关闭公开注册。设为 1 才允许 /setting/register
ALLOW_REGISTRATION=0

# local：图库存在 instance/Gallery/media
# oss：使用下面的阿里云配置（需额外安装 oss2，见 requirements-oss.txt）
STORAGE_BACKEND=local

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT_PUBLIC=
OSS_ENDPOINT_INTERNAL=
USE_OSS_INTERNAL=0
OSS_BASE_PREFIX=

# 可选。不填则 /llm 会提示未配置，不会请求外网。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 放在反向代理后面时设为 1，才会信任 X-Forwarded-* 头
BEHIND_PROXY=0

# 单次上传上限（MB）
MAX_CONTENT_LENGTH_MB=256
